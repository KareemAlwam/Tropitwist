# Vercel Services uses one origin for the React storefront and Express API.
NODE_ENV=production
DATABASE_URL=postgresql://<Neon pooled connection string>
FRONTEND_ORIGIN=https://tropitwist.vercel.app
ADMIN_EMAILS=owner@example.com
JWT_ACCESS_SECRET=use-a-random-secret-with-at-least-32-characters
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_CARD_INTEGRATION_ID=
PAYMOB_HMAC_SECRET=
PAYMOB_WEBHOOK_URL=https://tropitwist.vercel.app/api/v1/payments/paymob/webhook
PAYMOB_REDIRECT_URL=https://tropitwist.vercel.app/checkout
